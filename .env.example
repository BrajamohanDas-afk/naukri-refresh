# Gmail account that owns the App Password (SMTP sender)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password

# Inbox that receives the refresh report
MAIL_TO=your-inbox@example.com

# Naukri login (used once by `npm run login` to create the saved session)
NAUKRI_USER=your-naukri-login@example.com
NAUKRI_PASS=your-naukri-password
